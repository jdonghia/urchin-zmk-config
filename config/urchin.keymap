#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define HOLD_TAP_TAPPING_TERM 280
#define HOLD_TAP_QUICK_TAP 175
#define PRIOR_IDLE_MS 150

// Layer definitions

#define BASE 0
#define SYM 1
#define EXT 2
#define SETTINGS 3

// -----------------

/ {
    behaviors {
        // Left-hand HRMs
        // Right-hand HRMs
    };

    combos {
        compatible = "zmk,combos";

        settings_layer {
            bindings = <&mo 3>;
            key-positions = <32 33>;
            timeout-ms = <50>;
            require-prior-idle-ms = <PRIOR_IDLE_MS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Base";
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T           &kp Y      &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D  &kp F  &kp G           &kp H      &kp J  &kp K      &kp L    &kp SINGLE_QUOTE
&kp Z  &kp X  &kp C  &kp V  &kp B           &kp N      &kp M  &kp COMMA  &kp DOT  &kp SLASH
                     &mo 2  &kp LEFT_SHIFT  &kp SPACE  &mo 1
            >;
        };

        sym_layer {
            label = "Sym.";
            bindings = <
&kp NUMBER_1   &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5  &kp N6         &kp N7     &kp NUMBER_8  &kp N9            &kp N0
&kp SEMICOLON  &trans        &trans        &kp GRAVE     &trans  &trans         &trans     &trans        &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans         &trans        &trans        &trans        &trans  &kp BACKSLASH  &kp MINUS  &kp EQUAL     &trans            &trans
                                           &mo 4         &trans  &trans         &trans
            >;
        };

        fnc_layer {
            label = "fnc";
            bindings = <
&kp ESCAPE  &trans            &trans        &trans            &trans  &trans     &trans            &trans        &trans            &kp BACKSPACE
&trans      &sk LEFT_CONTROL  &sk LEFT_ALT  &sk LEFT_COMMAND  &trans  &trans     &sk LEFT_COMMAND  &sk LEFT_ALT  &sk LEFT_CONTROL  &kp TAB
&trans      &trans            &trans        &trans            &trans  &trans     &trans            &trans        &trans            &kp LS(TAB)
                                            &trans            &trans  &kp ENTER  &kp LS(ENTER)
            >;
        };

        settings_layer {
            label = "Sett.";
            bindings = <
&kp C_BRIGHTNESS_DEC  &kp C_BRI_UP       &kp C_PREV       &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &trans  &trans  &trans  &trans
&kp C_MUTE            &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans            &trans      &trans  &trans  &trans  &trans  &trans
&bootloader           &trans             &trans           &trans            &trans      &trans  &trans  &trans  &trans  &bootloader
                                                          &trans            &trans      &trans  &trans
            >;
        };

        ext_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans        &trans     &trans
&trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &trans        &trans     &trans
                        &trans  &trans  &trans    &trans
            >;

            label = "ext";
        };
    };
};
